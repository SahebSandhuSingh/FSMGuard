{
  "states": [
    "IDLE",
    "SYN_WAIT",
    "AUTH",
    "CONNECTED",
    "DATA_XFER",
    "ADMIN",
    "DISCONNECT"
  ],
  "transitions": [
    {
      "src": "IDLE",
      "dst": "SYN_WAIT",
      "condition": "syn_received"
    },
    {
      "src": "SYN_WAIT",
      "dst": "ADMIN",
      "condition": "admin_mode"
    },
    {
      "src": "SYN_WAIT",
      "dst": "AUTH",
      "condition": "always"
    },
    {
      "src": "AUTH",
      "dst": "CONNECTED",
      "condition": "auth_valid"
    },
    {
      "src": "AUTH",
      "dst": "DISCONNECT",
      "condition": "timeout"
    },
    {
      "src": "CONNECTED",
      "dst": "DATA_XFER",
      "condition": "data_ready"
    },
    {
      "src": "CONNECTED",
      "dst": "DISCONNECT",
      "condition": "timeout"
    },
    {
      "src": "DATA_XFER",
      "dst": "CONNECTED",
      "condition": "(Ulnot data_ready)"
    },
    {
      "src": "ADMIN",
      "dst": "DATA_XFER",
      "condition": "data_ready"
    },
    {
      "src": "ADMIN",
      "dst": "CONNECTED",
      "condition": "always"
    },
    {
      "src": "DISCONNECT",
      "dst": "IDLE",
      "condition": "always"
    }
  ],
  "reset_state": "IDLE"
}